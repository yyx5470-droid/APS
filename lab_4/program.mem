//реализация умножения a * sw_i, где а = 01011 
20000001 // reg_file[1] ← sw_i (загрузка значения с переключателей в регистр 1)
10042002 // reg_file[2] ← reg_file[1] + reg_file[1] (сдвиг влево на 1: умножение на 2)
10084003 // reg_file[3] ← reg_file[2] + reg_file[2] (сдвиг влево на 2: умножение на 4)
100C6004 // reg_file[4] ← reg_file[3] + reg_file[3] (сдвиг влево на 3: умножение на 8)
10044005 // reg_file[5] ← reg_file[1] + reg_file[2] (промежуточная сумма: sw_i*1 + sw_i*2)
10148006 // reg_file[6] ← reg_file[5] + reg_file[4] (итоговая сумма: (sw_i*3) + sw_i*8 = sw_i * 11)
80180000 // out_o = reg_file[6], PC ← PC + 0 (вывод результата на индикаторы и зацикливание)
